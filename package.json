{
  "name": "supreme-spork",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "e2e": "playwright test",
    "check": "biome check",
    "api:sync": "bun scripts/api-sync.ts",
    "api:gen": "openapi-typescript api/openapi.json -o src/server/api/schema.d.ts",
    "api:check": "bun run api:gen && git diff --exit-code -- src/server/api/schema.d.ts",
    "check:bundle": "bun scripts/check-bundle.ts"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.14",
    "@astryxdesign/theme-neutral": "^0.7.14",
    "@stylexjs/stylex": "^0.19.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "^0.7.14",
    "@biomejs/biome": "2.4.2",
    "@playwright/test": "1.65.1",
    "@types/bun": "1.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "openapi-typescript": "7.13.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
